{
  "outputDirectory": "out",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/support-cron",
      "schedule": "0 1 * * *"
    }
  ],
  "functions": {
    "api/template-ai.ts": {
      "maxDuration": 60
    },
    "api/support-inbound.ts": {
      "maxDuration": 30
    },
    "api/support-cron.ts": {
      "maxDuration": 60
    }
  }
}
