{
  "regions": [
    "sin1"
  ],
  "outputDirectory": "out",
  "redirects": [
    {
      "source": "/enquire/partner",
      "destination": "/partners",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "(?:.*\\.)?(?:thersvpstudio\\.com|vercel\\.app)"
        }
      ],
      "destination": "/api/invite-page?domain=1"
    },
    {
      "source": "/api/domain-search",
      "destination": "/api/pay-checkout?op=domain-search"
    },
    {
      "source": "/og/:slug.jpg",
      "destination": "/api/invite-page?op=og&slug=:slug"
    },
    {
      "source": "/qr/:slug.png",
      "destination": "/api/invite-page?op=qr&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/invite-page?op=sitemap"
    },
    {
      "source": "/api/site-health",
      "destination": "/api/pay-checkout?op=site-health"
    },
    {
      "source": "/api/media-upload",
      "destination": "/api/pay-checkout?op=upload-url"
    },
    {
      "source": "/api/domain-status",
      "destination": "/api/pay-checkout?op=domain-status"
    },
    {
      "source": "/invite/:slug",
      "destination": "/api/invite-page?slug=:slug"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/invite-page?op=blog&slug=:slug"
    },
    {
      "source": "/tools/seating-chart-maker",
      "destination": "/api/invite-page?op=page&path=seating"
    },
    {
      "source": "/tools/seating-chart-maker/view/:token",
      "destination": "/api/invite-page?op=page&path=view"
    },
    {
      "source": "/go/review/:token",
      "destination": "/api/invite-page?op=review&t=:token"
    },
    {
      "source": "/creators",
      "destination": "/api/invite-page?op=page&path=creators"
    },
    {
      "source": "/tools/seating-chart-maker/day/:token",
      "destination": "/api/invite-page?op=page&path=view"
    },
    {
      "source": "/build",
      "destination": "/api/invite-page?op=meta&p=/build"
    },
    {
      "source": "/pickleball",
      "destination": "/api/invite-page?op=meta&p=/pickleball"
    },
    {
      "source": "/build/:rest*",
      "destination": "/api/invite-page?op=meta&p=/build"
    },
    {
      "source": "/partners",
      "destination": "/api/invite-page?op=meta&p=/partners"
    },
    {
      "source": "/faqs",
      "destination": "/api/invite-page?op=meta&p=/faqs"
    },
    {
      "source": "/collections",
      "destination": "/api/invite-page?op=meta&p=/collections"
    },
    {
      "source": "/services",
      "destination": "/api/invite-page?op=meta&p=/services"
    },
    {
      "source": "/services/:page",
      "destination": "/api/invite-page?op=meta&p=/services/:page"
    },
    {
      "source": "/portfolio",
      "destination": "/api/invite-page?op=meta&p=/portfolio"
    },
    {
      "source": "/portfolio/:slug",
      "destination": "/api/invite-page?op=meta&p=/portfolio/:slug"
    },
    {
      "source": "/contact",
      "destination": "/api/invite-page?op=meta&p=/contact"
    },
    {
      "source": "/enquire",
      "destination": "/api/invite-page?op=meta&p=/enquire"
    },
    {
      "source": "/privacy",
      "destination": "/api/invite-page?op=meta&p=/privacy"
    },
    {
      "source": "/terms",
      "destination": "/api/invite-page?op=meta&p=/terms"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/support-cron",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/support-cron?only=outreach",
      "schedule": "30 1 * * *"
    }
  ],
  "functions": {
    "api/template-ai.ts": {
      "maxDuration": 60
    },
    "api/support-inbound.ts": {
      "maxDuration": 30
    },
    "api/support-cron.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|gif|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://checkout.paymongo.com\")"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/invite/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/account(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/studio(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/rate",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/internal/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
